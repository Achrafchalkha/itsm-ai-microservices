# Environment Variables Template
# Copy this file to .env and fill in your actual values

# Database Configuration
DB_URL_AUTH=jdbc:postgresql://localhost:5432/auth_db
DB_URL_USER=jdbc:postgresql://localhost:5432/user_db
DB_USERNAME=postgres
DB_PASSWORD=your_actual_password_here

# JWT Configuration
JWT_SECRET=your_jwt_secret_base64_encoded_here

# Kafka Configuration
KAFKA_BOOTSTRAP_SERVERS=localhost:9092

# Application Ports
AUTH_SERVICE_PORT=8081
USER_SERVICE_PORT=8082

# Instructions:
# 1. Copy this file: cp .env.example .env
# 2. Replace 'your_actual_password_here' with your PostgreSQL password
# 3. Replace 'your_jwt_secret_base64_encoded_here' with a secure JWT secret
# 4. Never commit the .env file to version control
